+static bool load_state_file(const char* path) {
+    FILE* f = fopen(path, "rb");
+    if (!f) { fprintf(stderr, "SNESREF_STATE_IN: cannot open %s\n", path); return false; }
+    fseek(f, 0, SEEK_END); long fn = ftell(f); fseek(f, 0, SEEK_SET);
+    size_t need = p_retro_serialize_size();
+    if (fn <= 0 || need == 0) { fclose(f); fprintf(stderr, "SNESREF_STATE_IN: bad sizes file=%ld need=%zu\n", fn, need); return false; }
+    size_t bn = ((size_t)fn > need) ? (size_t)fn : need;
+    std::vector<uint8_t> buf(bn, 0);
+    size_t got = fread(buf.data(), 1, (size_t)fn, f);
+    fclose(f);
+    printf("[state-in %s file=%ld coreNeeds=%zu read=%zu]\n", path, fn, need, got); fflush(stdout);
+    if ((size_t)fn != need)
+        printf("[warn state-in: size mismatch file=%ld need=%zu]\n", fn, need);
+    bool ok = p_retro_unserialize(buf.data(), need);
+    printf("[state-in %s]\n", ok ? "LOADED" : "unserialize returned FALSE"); fflush(stdout);
+    return ok;
+}
+
+static bool save_state_file(const char* path) {
+    size_t n = p_retro_serialize_size();
+    if (!n) return false;
+    std::vector<uint8_t> buf(n);
+    if (!p_retro_serialize(buf.data(), n)) return false;
+    FILE* f = fopen(path, "wb");
+    if (!f) return false;
+    size_t got = fwrite(buf.data(), 1, n, f);
+    fclose(f);
+    printf("[state-out %s %zu bytes]\n", path, got); fflush(stdout);
+    return got == n;
+}
