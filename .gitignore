# Generated recompiler output — derived from a copyrighted ROM. Never commit.
/src/gen/
/recomp/funcs.h

# The ROM itself, in every form. Players supply their own.
*.sfc
*.smc
*.srm
*.sav
*.state

# Build trees and packaged output
/build/
/build-*/
/dist/
/saves/

# Decomp workspace: generated/ROM-derived artifacts, never source
/decomp/build/
/decomp/.toolchain/
/decomp/rom/
/decomp/assets/
/decomp/out/

# Local probe output that names paths on one machine
/rom_probe.json

# Launcher/runtime state written beside the executable (and in the repo root
# when the game is run from there): the cached ROM path, keybinds, settings.
# All of it is one machine's, none of it is the project's.
/rom.cfg
/keybinds.ini
/config.ini
/input.ini
/last_run_report.json

.DS_Store

# Local reference material: save states, screenshots, crash logs, fan
# translations. See docs/reference-material.md. Never commit.
/reference/
/3f_junks*.png
/moldura_jogo_*.png
*.log

# Python bytecode from local tools
__pycache__/
*.pyc
